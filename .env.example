# SiliconFlow OpenAI-compatible provider. This is the default provider.
SILICONFLOW_API_KEY=

# Optional official OpenAI provider. Not enabled by default.
OPENAI_API_KEY=

# Optional official DeepSeek provider. Not enabled by default.
